*#define CHECK

* SquaredME.F
* assembly of squared matrix element
* generated by FormCalc 6 Aug 2012 0:33

	subroutine SquaredME(result, helicities, flags)
	implicit none
	double precision result(*)
	integer helicities, flags

#include "vars.h"

	double precision sumup
	external sumup

	integer Hel1, Hel2, Hel3, Hel4
	equivalence (Hel(1), Hel1)
	equivalence (Hel(2), Hel2)
	equivalence (Hel(3), Hel3)
	equivalence (Hel(4), Hel4)


	data MatSUN /1*bogus/

	S = SInvariant(1,2)

	T = TInvariant(1,3)

	U = TInvariant(2,3)


#define RESET_IF if( btest(flags, 0) ) then
#define RESET_ENDIF endif

#define LOOP_IF if( btest(flags, 1) ) then
#define LOOP_ENDIF endif

#define HEL_IF(i) if( btest(helicities, 13-3*i+Hel(i)) ) then
#define HEL_ENDIF(i) endif

	RESET_IF
	call abbr0_s
	RESET_ENDIF

	call markcache


	result(1) = 0
	result(2) = 0

	do Hel1 = -1, 1
	HEL_IF(1)
	do Hel2 = -1, 1
	HEL_IF(2)
	do Hel3 = -1, 1
	HEL_IF(3)
	do Hel4 = -1, 1
	HEL_IF(4)

	call abbr0_hel

	Ctree(1) = 0

	call born

	result(1) = result(1) + sumup(Ctree, Ctree)

	HEL_ENDIF(4)
	enddo
	HEL_ENDIF(3)
	enddo
	HEL_ENDIF(2)
	enddo
	HEL_ENDIF(1)
	enddo

	call restorecache

#ifdef CHECK
	print *, 'S =', S
	print *, 'T =', T
	print *, 'U =', U

	print *, 'tree =', result(1)
	print *, 'loop =', result(2)
	stop
#endif
	end


************************************************************************

	double precision function sumup(CCloop, CCtree)
	implicit none

#include "vars.h"

	double complex CCloop(1), CCtree(1)
	double complex m

	sumup = 0

	m = 0
	m = m + CCloop(1)*MatSUN(1,1)
	sumup = sumup + DBLE(DCONJG(CCtree(1))*m)
	end
